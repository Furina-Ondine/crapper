#!/bin/sh
# Run the CRAP tool, creating a local virtualenv on first use.
set -e
ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
  python3 -m venv "$ROOT/.venv"
fi
if [ ! -x "$ROOT/.venv/bin/crapper" ]; then
  "$PY" -m pip install -e "$ROOT" >&2
fi
exec "$PY" -m crapper "$@"
